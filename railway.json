{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "bot.Dockerfile",
    "watchPatterns": [
      "scripts/**",
      "src/lib/discord-messages.ts",
      "src/content/site.ts",
      "package.json",
      "package-lock.json",
      "bot.Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS"
  }
}
