# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# Where contact-form enquiries are delivered. Required for the form to send.
# There is deliberately no fallback in the source: a default address in the
# repo is a personal address published to everyone who can read it.
NOTIFICATION_EMAIL=

# Resend API key. Without it the form accepts submissions but delivers nothing.
RESEND_API_KEY=

# Verified sender, e.g. "Cerbis <hello@yourdomain.com>". Falls back to Resend's
# shared onboarding sender if unset or if your domain is not verified yet.
RESEND_FROM_EMAIL=

# Optional. A private Discord channel webhook to mirror enquiries into.
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Discord Application & Live Relay Bot Settings
# ---------------------------------------------------------------------------
# Discord Developer Portal -> Your App -> OAuth2 / General Information
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Developer Portal -> Bot -> Token (for running scripts/discord-bot.ts)
DISCORD_BOT_TOKEN=

# Your Discord Guild (Server) ID and the Admin Channel ID where you reply to clients.
# The bot needs, in that channel: View Channel, Send Messages, Create Public
# Threads, Send Messages in Threads, Manage Threads, Attach Files, and optionally
# Manage Webhooks (so client DMs show under the client's own name and avatar).
DISCORD_GUILD_ID=
DISCORD_ADMIN_CHANNEL_ID=

# Optional. Comma-separated Discord user IDs allowed to reply from client threads
# and change brief status. Empty means anyone who can see the admin channel.
DISCORD_ADMIN_USER_IDS=

# Direct 1-click install URL for user account or server (from Discord Dev Portal)
# Example: https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&integration_type=1&scope=identify+applications.commands
DISCORD_APPLICATION_INSTALL_URL=
