# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# Where contact-form enquiries are delivered. Required for the form to send.
# There is deliberately no fallback in the source: a default address in the
# repo is a personal address published to everyone who can read it.
NOTIFICATION_EMAIL=

# Resend API key. Without it the form accepts submissions but delivers nothing.
RESEND_API_KEY=

# Verified sender, e.g. "Cerbis <hello@yourdomain.com>". Falls back to Resend's
# shared onboarding sender if unset or if your domain is not verified yet.
RESEND_FROM_EMAIL=

# Optional. A private Discord channel webhook to mirror enquiries into.
DISCORD_WEBHOOK_URL=
